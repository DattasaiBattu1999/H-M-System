pipeline {
    agent any

    environment {
        AWS_REGION       = "ap-southeast-1" 
        CLUSTER_NAME     = "hm-kops-cluster.k8s.local" 
        KOPS_STATE_STORE = "s3://aws-hm-system-bucket" 
        K8S_NAMESPACE    = "Qa" 
    }

    stages {
        stage('Checkout & Fetch Artifacts') {
            steps {
                git credentialsId: 'GitHub', url: 'https://github.com/DattasaiBattu1999/H-M-System.git'
                
                copyArtifacts(
                    projectName: 'H-M-System_CI',
                    selector: lastSuccessful()
                )
                script {
                    env.IMAGE_TAG = readFile('image_tag.txt').trim()
                    echo "Deploying Version: ${env.IMAGE_TAG}"
                }
            }
        }
        
        stage('Create KOPS Cluster') {
            steps {
                sh """
                    kops get cluster --name=${CLUSTER_NAME} --state=${KOPS_STATE_STORE} || \\
                    kops create cluster \
                        --name=${CLUSTER_NAME} \
                        --state=${KOPS_STATE_STORE} \
                        --zones=ap-southeast-1a,ap-southeast-1b \
                        --control-plane-size=c7i-flex.large \
                        --control-plane-count=1 \
                        --node-count=2 \
                        --node-size=t3.micro \
                        --image=ami-05b741ae2ab9f1742 \
                        --yes

                    kops update cluster --name=${CLUSTER_NAME} --state=${KOPS_STATE_STORE} --yes
                    
                    kops validate cluster --name=${CLUSTER_NAME} --state=${KOPS_STATE_STORE} --wait 15m
                """
            }
        }

        stage('Update kubeconfig via KOPS') {
            steps {
                sh """
                    kops export kubeconfig \
                        --name ${CLUSTER_NAME} \
                        --state ${KOPS_STATE_STORE} \
                        --admin
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    kubectl get namespace ${K8S_NAMESPACE} || kubectl create namespace ${K8S_NAMESPACE}

                    rm -rf K8S-Generated
                    cp -r K8S-Files K8S-Generated
                    
                    find K8S-Generated/ -name "*.yml" -exec sed -i "s|IMAGE_TAG|${env.IMAGE_TAG}|g" {} +
                    find K8S-Generated/ -name "*.yml" -exec sed -i "s|namespace: prod|namespace: ${K8S_NAMESPACE}|g" {} +
                    
                    kubectl apply -f K8S-Generated/Security/ -n ${K8S_NAMESPACE}
                    kubectl apply -f K8S-Generated/Base/ -n ${K8S_NAMESPACE}
                    kubectl apply -f K8S-Generated/Networking/ -n ${K8S_NAMESPACE}
                    kubectl apply -f K8S-Generated/Auto-scalling/ -n ${K8S_NAMESPACE}
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                // Removed redundant script block to keep syntax cleaner
                sh "kubectl rollout status deployment/hms-backend -n ${K8S_NAMESPACE}"
                sh "kubectl rollout status deployment/hms-frontend -n ${K8S_NAMESPACE}"
                
                sh "kubectl get pods -n ${K8S_NAMESPACE}"
                sh "kubectl get svc -n ${K8S_NAMESPACE}"
            }
        }
    }

    post {
        always {
            sh "rm -rf K8S-Generated"
        }
        success {
            echo "Deployment of version ${env.IMAGE_TAG} successful to KOPS cluster!"
        }
        failure {
            echo "Deployment failed! Check KOPS cluster state or Kubernetes controller logs."
        }
    }
}