// H-M-System Deployment Pipeline
pipeline {
    agent any

    environment {
        AWS_REGION = "ap-south-1"
        CLUSTER_NAME = "hm-eks-cluster"
        K8S_NAMESPACE = "default" 
    }

    stages {
        stage('Fetch Artifact from CI') {
            steps {
                copyArtifacts(
                    projectName: 'H-M-System CI',
                    selector: lastSuccessful()
                )
                script {
                    env.IMAGE_TAG = readFile('image_tag.txt').trim()
                    echo "Deploying Version: ${env.IMAGE_TAG}"
                }
            }
        }

        stage('Update kubeconfig') {
            steps {
                sh "aws eks --region $AWS_REGION update-kubeconfig --name $CLUSTER_NAME"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    # Create clean runtime copies of manifests
                    rm -rf K8S-Generated
                    cp -r K8S-Files K8S-Generated
                    
                    # Target and swap image tags safely
                    find K8S-Generated/ -name "*.yml" -exec sed -i "s|IMAGE_TAG|${IMAGE_TAG}|g" {} +
                    
                    # Apply manifest groups sequentially
                    kubectl apply -f K8S-Generated/Security/
                    kubectl apply -f K8S-Generated/Base/
                    kubectl apply -f K8S-Generated/Networking/
                    kubectl apply -f K8S-Generated/Auto-scalling/
                """
            }
        }

        stage('Verify Rollout') {
            steps {
                script {
                    sh "kubectl rollout status deployment/backend-deployment -n ${K8S_NAMESPACE}"
                    sh "kubectl rollout status deployment/frontend-deployment -n ${K8S_NAMESPACE}"
                    
                    sh "kubectl get pods -n ${K8S_NAMESPACE}"
                    sh "kubectl get svc -n ${K8S_NAMESPACE}"
                }
            }
        }
    }

    post {
        always {
            sh "rm -rf K8S-Generated"
        }
        success {
            echo "Deployment of version ${IMAGE_TAG} successful!"
        }
        failure {
            echo "Deployment failed! Check Kubernetes logs."
        }
    }
}